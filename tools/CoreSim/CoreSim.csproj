<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity-independent simulation core outside Unity (fast checks, baseline KPIs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion> <!-- Unity 6 compiles C# 9 -->
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/Assets/ShuttleRL/Scripts/Core/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
